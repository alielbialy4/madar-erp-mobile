# API base URL — must include /api (same as front REACT_APP_API_URL)
# Herd local backend (matches back/.env APP_URL=http://back.test):
EXPO_PUBLIC_API_URL=http://back.test/api

# Production example:
# EXPO_PUBLIC_API_URL=https://back-madar.amen-card.com/api

# Physical Android device / emulator if back.test fails — use your Mac LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.100/api

EXPO_PUBLIC_DEFAULT_TENANT_SLUG=
EXPO_PUBLIC_TIMEZONE=Africa/Cairo

# EAS internal/preview builds: set the same variables in eas.json "env" or Expo dashboard secrets.
# Do not use placeholder https://your-api-domain.com in real device builds.
