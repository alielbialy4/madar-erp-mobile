{
  "expo": {
    "name": "Madar ERP",
    "slug": "madar-erp-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "madarerp",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madar.erp.mobile"
    },
    "android": {
      "package": "com.madar.erp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "timezone": "Africa/Cairo"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
