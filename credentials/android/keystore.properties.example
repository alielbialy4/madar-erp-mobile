# Copy to keystore.properties (gitignored) or let scripts/build-play-aab.sh create it.
# This is the UPLOAD key. You generate it locally — Play Console does not give you a keystore.
storeFile=/absolute/path/to/app/credentials/android/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
